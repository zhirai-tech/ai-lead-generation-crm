# ZHIRAI Europe B2B AI Outreach Platform - environment example
# Copy to .env and adjust. Never commit .env.

# --- Server ---
HOST=127.0.0.1
PORT=4173
APP_NAME=ZHIRAI Outreach
# Set to 1 only when running behind a trusted reverse proxy (nginx / caddy)
TRUST_PROXY=0
# Public base URL used in unsubscribe links and email footers
PUBLIC_BASE_URL=http://127.0.0.1:4173

# --- Data ---
DATA_DIR=server/data
LOG_LEVEL=info

# --- Sessions ---
SESSION_TTL_HOURS=168

# --- Background worker ---
WORKER_ENABLED=1
WORKER_POLL_MS=1000

# --- AI provider fallback (optional; normally configured in the UI, encrypted at rest) ---
# Leave empty to use the built-in deterministic simulation provider for demos/tests.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Safety ---
# Automatically pause all automated sending if this is set to 1
GLOBAL_SEND_PAUSED=0
